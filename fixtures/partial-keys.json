{
  "$schema": "./schema.json",
  "name": "partial-keys",
  "feature": "key.hold",
  "description": "A Left arm key on 10 is a partial key; removing its only part removes the key. Holding the Left arm from 0 to 20 adds a Left arm key on 20. Setting key 0's root z channel (axis 5) to 1.5 hip heights puts the root at 0.0504142 + 1.5 x 0.8698308 = 1.3551604.",
  "script": [
    {
      "command": "pose.set_root",
      "params": {
        "root": [
          0,
          0,
          0
        ]
      }
    },
    {
      "command": "key.set",
      "params": {}
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 10
      }
    },
    {
      "command": "pose.set_bone",
      "params": {
        "bone": "wrist.L",
        "rotation": [
          0,
          0,
          0.3826834323650898,
          0.9238795325112867
        ]
      }
    },
    {
      "command": "key.set",
      "params": {
        "parts": [
          "Left arm"
        ]
      }
    },
    {
      "command": "editor.state",
      "params": {},
      "expect": {
        "keys": [
          {
            "frame": 0
          },
          {
            "frame": 10,
            "part": "Left arm"
          }
        ]
      }
    },
    {
      "command": "key.remove_parts",
      "params": {
        "frame": 10,
        "parts": [
          "Left arm"
        ]
      }
    },
    {
      "command": "editor.state",
      "params": {},
      "expect": {
        "keys": [
          {
            "frame": 0
          }
        ]
      }
    },
    {
      "command": "key.hold",
      "params": {
        "from": 0,
        "to": 20,
        "parts": [
          "Left arm"
        ]
      }
    },
    {
      "command": "editor.state",
      "params": {},
      "expect": {
        "keys": [
          {
            "frame": 0
          },
          {
            "frame": 20,
            "part": "Left arm"
          }
        ]
      }
    },
    {
      "command": "key.channel",
      "params": {
        "bone": "root",
        "frame": 0,
        "axis": 5,
        "value": 1.5
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 0
      }
    },
    {
      "command": "bone.world",
      "params": {
        "bone": "root"
      },
      "expect": {
        "position": [
          0,
          -0.0108229,
          1.3551604
        ]
      }
    }
  ],
  "expect": {
    "tolerance": 1e-06
  },
  "errors": [
    {
      "command": "key.remove_parts",
      "params": {
        "frame": 5
      }
    },
    {
      "command": "key.hold",
      "params": {
        "from": 20,
        "to": 10
      }
    },
    {
      "command": "key.channel",
      "params": {
        "bone": "wrist.L",
        "frame": 0,
        "axis": 4,
        "value": 1
      }
    }
  ],
  "views": [
    "front"
  ]
}
