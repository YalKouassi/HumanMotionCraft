{
  "$schema": "./schema.json",
  "name": "library-poses-parts",
  "feature": "pose.apply",
  "description": "A Left arm pose saved with the wrist turned 45 degrees about Z comes back after a reset (the wrist's world rotation is its own: every parent is at identity). Rename and regroup give the ids shown. A part set of both arms keys as one part and is listed by that name.",
  "script": [
    {
      "command": "pose.set_root",
      "params": {
        "root": [
          0,
          0,
          0
        ]
      }
    },
    {
      "command": "pose.set_bone",
      "params": {
        "bone": "wrist.L",
        "rotation": [
          0,
          0,
          0.3826834323650898,
          0.9238795325112867
        ]
      }
    },
    {
      "command": "pose.save",
      "params": {
        "name": "Wave",
        "group": "Mine",
        "parts": [
          "Left arm"
        ]
      },
      "expect": {
        "id": "Mine/Wave"
      }
    },
    {
      "command": "pose.reset",
      "params": {}
    },
    {
      "command": "pose.apply",
      "params": {
        "id": "Mine/Wave",
        "key": false
      }
    },
    {
      "command": "bone.world",
      "params": {
        "bone": "wrist.L"
      },
      "expect": {
        "rotation": [
          0,
          0,
          0.3826834,
          0.9238795
        ]
      }
    },
    {
      "command": "pose.rename",
      "params": {
        "id": "Mine/Wave",
        "to": "Hi"
      },
      "expect": {
        "id": "Mine/Hi"
      }
    },
    {
      "command": "pose.group",
      "params": {
        "id": "Mine/Hi",
        "group": "Other"
      },
      "expect": {
        "id": "Other/Hi"
      }
    },
    {
      "command": "pose.delete",
      "params": {
        "id": "Other/Hi"
      }
    },
    {
      "command": "parts.save",
      "params": {
        "name": "Both arms",
        "parts": [
          "Left arm",
          "Right arm"
        ]
      },
      "expect": {
        "name": "Both arms"
      }
    },
    {
      "command": "key.set",
      "params": {
        "parts": [
          "Both arms"
        ]
      }
    },
    {
      "command": "editor.state",
      "params": {},
      "expect": {
        "keys": [
          {
            "frame": 0,
            "part": "Both arms"
          }
        ]
      }
    },
    {
      "command": "parts.delete",
      "params": {
        "name": "Both arms"
      }
    },
    {
      "command": "editor.state",
      "params": {},
      "expect": {
        "keys": [
          {
            "frame": 0
          }
        ]
      }
    }
  ],
  "expect": {
    "tolerance": 1e-06
  },
  "errors": [
    {
      "command": "pose.save",
      "params": {
        "name": "///"
      }
    },
    {
      "command": "pose.apply",
      "params": {
        "id": "Other/Hi"
      }
    },
    {
      "command": "pose.rename",
      "params": {
        "id": "No/Such",
        "to": "x"
      }
    },
    {
      "command": "pose.group",
      "params": {
        "id": "No/Such",
        "group": "X"
      }
    },
    {
      "command": "pose.delete",
      "params": {
        "id": "No/Such"
      }
    },
    {
      "command": "parts.save",
      "params": {
        "name": "Whole body",
        "parts": [
          "Head"
        ]
      }
    },
    {
      "command": "parts.delete",
      "params": {
        "name": "Nope"
      }
    }
  ],
  "views": [
    "front"
  ]
}
