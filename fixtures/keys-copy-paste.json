{
  "$schema": "./schema.json",
  "name": "keys-copy-paste",
  "feature": "keys.paste",
  "description": "Linear keys: frame 0 at rest (root x 0), frame 10 with the root at x = 1 hip height and wrist.L turned 45 degrees about Z, q = [0, 0, sin 22.5, cos 22.5] (physics off). Copy both and paste at 20: keys 20 and 30, nothing replaced; frame 25 is half way back from x = 0 to 1: 0.5 x 0.8698308 = 0.4349154. Paste mirrored at 30: frames 30 and 40, the key on 30 replaced. Mirrored, the root's sideways motion turns about where the first copied key stood (x 0): x = -1 on 40, -0.8698308; the wrist turn lands on wrist.R the other way, [0, 0, -0.3826834, 0.9238795], and wrist.L is at rest (every parent at rest, so world = local).",
  "script": [
    {
      "command": "physics.set",
      "params": {
        "on": false
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 0
      }
    },
    {
      "command": "pose.set_root",
      "params": {
        "root": [
          0,
          0,
          0
        ]
      }
    },
    {
      "command": "key.set",
      "params": {
        "interp": "linear"
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 10
      }
    },
    {
      "command": "pose.set_root",
      "params": {
        "root": [
          1,
          0,
          0
        ]
      }
    },
    {
      "command": "pose.set_bone",
      "params": {
        "bone": "wrist.L",
        "rotation": [
          0,
          0,
          0.3826834323650898,
          0.9238795325112867
        ]
      }
    },
    {
      "command": "key.set",
      "params": {
        "interp": "linear"
      }
    },
    {
      "command": "keys.copy",
      "params": {
        "frames": [
          0,
          10
        ]
      },
      "expect": {
        "copied": 2
      }
    },
    {
      "command": "keys.paste",
      "params": {
        "at": 20
      },
      "expect": {
        "frames": [
          20,
          30
        ],
        "replaced": []
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 25
      }
    },
    {
      "command": "bone.world",
      "params": {
        "bone": "root"
      },
      "expect": {
        "position": [
          0.4349154,
          -0.0108229,
          0.0504142
        ]
      }
    },
    {
      "command": "keys.paste",
      "params": {
        "at": 30,
        "mirror": true
      },
      "expect": {
        "frames": [
          30,
          40
        ],
        "replaced": [
          30
        ]
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 40
      }
    },
    {
      "command": "bone.world",
      "params": {
        "bone": "root"
      },
      "expect": {
        "position": [
          -0.8698308,
          -0.0108229,
          0.0504142
        ]
      }
    },
    {
      "command": "bone.world",
      "params": {
        "bone": "wrist.R"
      },
      "expect": {
        "rotation": [
          0,
          0,
          -0.3826834,
          0.9238795
        ]
      }
    },
    {
      "command": "bone.world",
      "params": {
        "bone": "wrist.L"
      },
      "expect": {
        "rotation": [
          0,
          0,
          0,
          1
        ]
      }
    },
    {
      "command": "editor.state",
      "params": {},
      "expect": {
        "keys": [
          {
            "frame": 0
          },
          {
            "frame": 10
          },
          {
            "frame": 20
          },
          {
            "frame": 30
          },
          {
            "frame": 40
          }
        ]
      }
    }
  ],
  "expect": {
    "tolerance": 1e-06
  },
  "errors": [
    {
      "command": "keys.copy",
      "params": {
        "frames": [
          5
        ]
      }
    },
    {
      "command": "keys.copy",
      "params": {
        "frames": []
      }
    },
    {
      "command": "keys.paste",
      "params": {
        "at": 9999995
      }
    }
  ]
}
