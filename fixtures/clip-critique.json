{
  "$schema": "./schema.json",
  "name": "clip-critique",
  "feature": "clip.critique",
  "description": "A review ranks what clip.metrics measures into findings with a fix. The clip of clip-metrics (physics off; linear keys at 0, 10 (slid 12 cm along +X), 20 and 30 (also lowered 5 cm)): both feet slide 12 cm while planted on frames 0–30 (high: 10 cm or more; score 12 / 10 = 1.2; fix feet.lock), and both feet go 3 cm into the floor on frames 25–30 (high: 2 cm or more; score 3 / 2 = 1.5, so it comes first). A fix is offered only if, run on a copy, it lessens its own finding and worsens no other: lifting each foot 3 + 0.5 cm on frame 30 clears the floor but stretches the slide from 12 to 13.15 cm (measured), so that finding offers no fix and says so, while feet.lock is offered. The velocity changes at the keys (0.36 and 0.15 m/s) are under 1 m/s: no pop findings. Making that lift by hand through edit.batch makes one undo step and puts the left ankle, 0.0734171 m up at rest, at 0.0734171 - 0.05 + 0.035 = 0.0584171 m on frame 30 (it was 0.0234171). With `limit` 1 only the first finding comes back.",
  "script": [
    {
      "command": "physics.set",
      "params": {
        "on": false
      }
    },
    {
      "command": "key.set",
      "params": {
        "interp": "linear"
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 10
      }
    },
    {
      "command": "pose.set_root",
      "params": {
        "root": [
          0.13795785962212959,
          0,
          0.9450101408607229
        ]
      }
    },
    {
      "command": "key.set",
      "params": {
        "interp": "linear"
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 20
      }
    },
    {
      "command": "key.set",
      "params": {
        "interp": "linear"
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 30
      }
    },
    {
      "command": "pose.set_root",
      "params": {
        "root": [
          0.13795785962212959,
          0,
          0.8875276993515022
        ]
      }
    },
    {
      "command": "key.set",
      "params": {
        "interp": "linear"
      }
    },
    {
      "command": "pose.query",
      "params": {
        "frame": 30,
        "pairs": [
          [
            "foot.L",
            "floor"
          ]
        ]
      },
      "expect": {
        "pairs": [
          {
            "a": "foot.L",
            "b": "floor",
            "distance": 0.0234171
          }
        ]
      }
    },
    {
      "command": "clip.critique",
      "params": {
        "motion": "keys"
      },
      "expect": {
        "count": 3,
        "findings": [
          {
            "kind": "penetration",
            "severity": "high",
            "score": 1.5,
            "frames": [
              25,
              30
            ],
            "command": null,
            "batch": []
          },
          {
            "kind": "sliding",
            "severity": "high",
            "score": 1.2,
            "frames": [
              0,
              30
            ],
            "command": "feet.lock",
            "params": {}
          },
          {
            "kind": "sliding",
            "severity": "high",
            "score": 1.2,
            "frames": [
              0,
              30
            ],
            "command": "feet.lock",
            "params": {}
          }
        ]
      },
      "tolerance": 0.0001
    },
    {
      "command": "edit.batch",
      "params": {
        "label": "Lift the feet out of the floor",
        "commands": [
          {
            "id": "frame.set",
            "params": {
              "frame": 30
            }
          },
          {
            "id": "pose.drag",
            "params": {
              "bone": "foot.L",
              "by": [
                0,
                0,
                0.035
              ]
            }
          },
          {
            "id": "pose.drag",
            "params": {
              "bone": "foot.R",
              "by": [
                0,
                0,
                0.035
              ]
            }
          },
          {
            "id": "key.set",
            "params": {}
          }
        ]
      },
      "expect": {
        "done": 4,
        "changed": {
          "keys": [
            {
              "layer": "Base",
              "edited": [
                30
              ]
            }
          ]
        }
      }
    },
    {
      "command": "pose.query",
      "params": {
        "frame": 30,
        "pairs": [
          [
            "foot.L",
            "floor"
          ]
        ]
      },
      "expect": {
        "pairs": [
          {
            "distance": 0.0584171
          }
        ]
      }
    },
    {
      "command": "edit.history",
      "expect": {
        "steps": {
          "$contains": [
            {
              "label": "Lift the feet out of the floor",
              "command": "edit.batch"
            }
          ]
        }
      }
    },
    {
      "command": "clip.critique",
      "params": {
        "motion": "keys",
        "limit": 1
      },
      "expect": {
        "count": 1
      }
    }
  ],
  "errors": [
    {
      "command": "clip.critique",
      "params": {
        "limit": 0
      }
    },
    {
      "command": "clip.critique",
      "params": {
        "from": 40
      }
    }
  ]
}
