{
  "$schema": "./schema.json",
  "name": "export-glb",
  "feature": "clip.export",
  "description": "Exporting one library walk with the game profile keeps the rig's 68 game joints and writes one animation. The round trip of the matrices is checked by ac-io's export test.",
  "script": [
    {
      "command": "clip.export",
      "params": {
        "path": "{tmp}/walk.glb",
        "ids": [
          "Locomotion/Walk"
        ],
        "profile": "game"
      },
      "expect": {
        "joints": 68,
        "animations": 1
      }
    },
    {
      "command": "clip.export",
      "params": {
        "path": "{tmp}/arm.glb",
        "ids": [
          "Locomotion/Walk"
        ],
        "bones": [
          "root",
          "upperarm01.L",
          "wrist.L"
        ]
      },
      "expect": {
        "joints": 3
      }
    }
  ],
  "expect": {
    "tolerance": 1e-06
  },
  "errors": [
    {
      "command": "clip.export",
      "params": {
        "path": "{tmp}/walk.txt"
      }
    },
    {
      "command": "clip.export",
      "params": {
        "path": "{tmp}/w.glb",
        "profile": "huge"
      }
    },
    {
      "command": "clip.export",
      "params": {
        "path": "{tmp}/w.glb",
        "bones": [
          "hand.L"
        ]
      }
    }
  ],
  "views": [
    "front"
  ]
}
