{
  "$schema": "./schema.json",
  "name": "key-move-parts",
  "feature": "key.move_parts",
  "description": "A dope-sheet row drag moves one part's keys. Linear keys on 0 (rest) and 10 (wrist.L turned 45 degrees about Z), physics off. Moving the Left arm from 10 to 20 leaves 10 keying every row but the Left arm and makes a Left arm key on 20. The Left arm now runs from rest on 0 to 45 degrees on 20, so on 10 it is half way: 22.5 degrees, [0, 0, sin 11.25, cos 11.25] = [0, 0, 0.1950903, 0.9807853]. Moving it from 20 onto the key on 0 merges it there (the key on 20, left with nothing, goes): the wrist is 45 degrees on 0 and stays so on 10.",
  "script": [
    {
      "command": "physics.set",
      "params": {
        "on": false
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 0
      }
    },
    {
      "command": "pose.set_root",
      "params": {
        "root": [
          0,
          0,
          0
        ]
      }
    },
    {
      "command": "key.set",
      "params": {
        "interp": "linear"
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 10
      }
    },
    {
      "command": "pose.set_root",
      "params": {
        "root": [
          0,
          0,
          0
        ]
      }
    },
    {
      "command": "pose.set_bone",
      "params": {
        "bone": "wrist.L",
        "rotation": [
          0,
          0,
          0.3826834323650898,
          0.9238795325112867
        ]
      }
    },
    {
      "command": "key.set",
      "params": {
        "interp": "linear"
      }
    },
    {
      "command": "key.move_parts",
      "params": {
        "from": 10,
        "to": 20,
        "parts": [
          "Left arm"
        ]
      }
    },
    {
      "command": "editor.state",
      "params": {},
      "expect": {
        "keys": [
          {
            "frame": 0
          },
          {
            "frame": 10,
            "part": "Hips + Spine + Head + Right arm + Left leg + Right leg"
          },
          {
            "frame": 20,
            "part": "Left arm"
          }
        ]
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 10
      }
    },
    {
      "command": "bone.world",
      "params": {
        "bone": "wrist.L"
      },
      "expect": {
        "rotation": [
          0,
          0,
          0.1950903,
          0.9807853
        ]
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 20
      }
    },
    {
      "command": "bone.world",
      "params": {
        "bone": "wrist.L"
      },
      "expect": {
        "rotation": [
          0,
          0,
          0.3826834,
          0.9238795
        ]
      }
    },
    {
      "command": "key.move_parts",
      "params": {
        "from": 20,
        "to": 0,
        "parts": [
          "Left arm"
        ]
      }
    },
    {
      "command": "editor.state",
      "params": {},
      "expect": {
        "keys": [
          {
            "frame": 0
          },
          {
            "frame": 10
          }
        ]
      }
    },
    {
      "command": "frame.set",
      "params": {
        "frame": 10
      }
    },
    {
      "command": "bone.world",
      "params": {
        "bone": "wrist.L"
      },
      "expect": {
        "rotation": [
          0,
          0,
          0.3826834,
          0.9238795
        ]
      }
    }
  ],
  "expect": {
    "tolerance": 1e-06
  },
  "errors": [
    {
      "command": "key.move_parts",
      "params": {
        "from": 10,
        "to": 30,
        "parts": [
          "Left arm"
        ]
      }
    },
    {
      "command": "key.move_parts",
      "params": {
        "from": 5,
        "to": 6,
        "parts": [
          "Head"
        ]
      }
    },
    {
      "command": "key.move_parts",
      "params": {
        "from": 0,
        "to": 3,
        "parts": []
      }
    },
    {
      "command": "key.move_parts",
      "params": {
        "from": 0,
        "to": 3,
        "parts": [
          "Tail"
        ]
      }
    }
  ]
}
